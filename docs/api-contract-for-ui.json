{
  "version": "2026-04-28",
  "base_url_note": "Set by deployment (e.g. http://localhost:8087)",
  "common": {
    "prefecture_source": "andersan.Neighbors",
    "datehour": "ISO8601 or 'now' for supported endpoints",
    "response_shape": {
      "spec": "schema and item list",
      "data": "tile arrays and values",
      "meta": {
        "cached_at": "response build time",
        "source_time": "prediction base time"
      }
    }
  },
  "endpoints": [
    {
      "path": "/ox/{model}/{prefecture}/{datehour}",
      "method": "GET",
      "models": [
        "v0",
        "v0a",
        "v1",
        "v1a",
        "a1"
      ],
      "kind": "regression_ox",
      "data_keys_pattern": "+{hour}",
      "hours": "model dependent (+1..+8 or +1..+24)"
    },
    {
      "path": "/ox/{model}/pgt120/{prefecture}/{datehour}",
      "method": "GET",
      "models": [
        "v0",
        "v0a",
        "v1",
        "v1a",
        "a1"
      ],
      "kind": "exceedance_probability_from_table",
      "threshold_ppb": 120,
      "data_keys_pattern": "+{hour}_p_gt_120"
    },
    {
      "path": "/oxq/a4_1/{prefecture}/{datehour}",
      "method": "GET",
      "kind": "quantile_regression",
      "quantiles": [
        0.1,
        0.5,
        0.9
      ],
      "horizons": 24,
      "data_keys_pattern": "+{hour}_q10/+{hour}_q50/+{hour}_q90"
    },
    {
      "path": "/oxq/a4_1/pgt120/{prefecture}/{datehour}",
      "method": "GET",
      "kind": "exceedance_probability_from_quantiles",
      "threshold_ppb": 120,
      "algorithm": "monotone_piecewise_linear_cdf",
      "data_keys_pattern": "+{hour}_p_gt_120",
      "horizons": 24
    },
    {
      "path": "/oxq/a3_16/{prefecture}/{datehour}",
      "method": "GET",
      "kind": "quantile_regression",
      "model": "andersan3_16",
      "quantiles": [
        0.5,
        0.9,
        0.95
      ],
      "horizons": 24,
      "data_keys_pattern": "+{hour}_q50/+{hour}_q90/+{hour}_q95"
    },
    {
      "path": "/oxq/a3_16/pgt120/{prefecture}/{datehour}",
      "method": "GET",
      "kind": "exceedance_probability_from_quantiles",
      "model": "andersan3_16",
      "threshold_ppb": 120,
      "algorithm": "monotone_piecewise_linear_cdf",
      "data_keys_pattern": "+{hour}_p_gt_120",
      "horizons": 24
    },
    {
      "path": "/ptable/{model}",
      "method": "GET",
      "models": [
        "v0",
        "v0a",
        "v1",
        "v1a",
        "a1"
      ],
      "kind": "probability_lookup_table"
    }
  ]
}
